# Traefik — reverse proxy
APP_PROJECT=network-map
APP_DOMAIN=network-map.example.com
# TLS_CERT_RESOLVER=letsencrypt

# Network Map — configuration
# Copier ce fichier en .env et ajuster selon le déploiement
# docker compose charge automatiquement .env à la racine

# Sous-réseau à scanner (nmap ARP ping)
SCAN_SUBNET=192.168.1.0/24

# Intervalle du scan périodique en minutes (0 = désactiver)
# Sous macOS le scan périodique vit dans la VM Docker et ne voit pas le vrai LAN. Désactiver et utiliser `bash scan-host.sh` à la main.
SCAN_INTERVAL_MINUTES=15

# Délai avant qu'un device découvert soit considéré hors ligne (minutes)
OFFLINE_TIMEOUT_MINUTES=30

# Sous-réseaux à exclure de la découverte (liste comma-séparée de CIDR)
# Utile en dev macOS pour ignorer les réseaux internes Docker
# Exemple: SCAN_EXCLUDE_SUBNETS=172.30.0.0/16,192.168.139.0/24
SCAN_EXCLUDE_SUBNETS=
